{
  "name": "nebula-backend",
  "version": "1.0.0",
  "description": "Nebula API — REST backend indexing and serving the Soroban task marketplace",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
